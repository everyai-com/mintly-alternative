{
  "name": "vessel-agent-docs",
  "version": "0.4.0",
  "private": true,
  "description": "An open-source, agent-ready documentation layer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check:only": "node scripts/check-docs.mjs",
    "docs:check": "npm run docs:build && npm run docs:check:only",
    "build": "npm run docs:build && vite build",
    "test": "npm run docs:build && npm run docs:check:only && node --test tests/core.test.mjs",
    "verify": "npm run build && npm test",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "wrangler": "^4.44.0",
    "yaml": "^2.9.0"
  }
}
