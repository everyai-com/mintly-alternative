{
  "name": "vessel-agent-docs",
  "version": "0.2.0",
  "private": true,
  "description": "An open-source, agent-ready documentation layer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "docs:build": "node scripts/build-docs.mjs",
    "build": "npm run docs:build && vite build",
    "test": "npm run docs:build && node --test tests/core.test.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "wrangler": "^4.44.0"
  }
}
