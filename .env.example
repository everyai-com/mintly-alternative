# Provider configuration for the private assistant gateway.
# Never commit real keys. For Cloudflare use `wrangler secret put AI_API_KEY`.
# For Netlify set these in Site configuration > Environment variables.
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
ALLOW_CUSTOM_ENDPOINTS=false

# Optional provider-specific keys. AI_API_KEY takes precedence when sent per request.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional GitHub App integration.
GITHUB_APP_SLUG=
